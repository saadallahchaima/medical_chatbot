# MediAgent — Environment Configuration
# Copy this file to .env and fill in your API keys

# ── LLM Provider ──────────────────────────────────────────────────────────
# Options: groq | ollama | openai | anthropic | gemini
LLM_PROVIDER=groq

# ── API Keys ──────────────────────────────────────────────────────────────
# Only fill in the key for your chosen provider above

# Groq (FREE) — Get your key at https://console.groq.com/keys
# Supports: llama-3.3-70b, llama-3.2-vision, whisper (voice transcription)
GROQ_API_KEY=
# OpenAI (paid) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_openai_key_here

# Anthropic (paid) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your_google_key_here

# PubMed/NCBI (free) — https://ncbi.nlm.nih.gov/account/
# PUBMED_API_KEY=your_pubmed_key_here

# ── LLM Model ─────────────────────────────────────────────────────────────
# Groq models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
# Ollama models: llama3.2 | mistral | phi3 | gemma2
# OpenAI models: gpt-4o | gpt-4o-mini
# Anthropic models: claude-3-5-sonnet-20241022
# Gemini models: gemini-1.5-flash
LLM_MODEL=llama-3.3-70b-versatile

# ── Optional Settings ─────────────────────────────────────────────────────
# DEBUG=false
# OLLAMA_BASE_URL=http://localhost:11434

